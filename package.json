{
  "name": "okhttp-debug-desktop",
  "version": "0.1.2",
  "description": "Tauri desktop console for Android OkHttp WebSocket debug captures.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "dev": "tauri dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build:renderer:if-stale": "node scripts/build-renderer-if-stale.mjs",
    "build": "npm run build:renderer",
    "prepare:adb": "node scripts/prepare-adb-resource.mjs",
    "fetch:adb": "node scripts/fetch-platform-tools.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:package:mac": "node scripts/package-tauri.mjs --platform macos",
    "tauri:package:windows": "node scripts/package-tauri.mjs --platform windows",
    "tauri:package:linux": "node scripts/package-tauri.mjs --platform linux"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
